# Paths used by the scripts in src/.  Copy this file to ".env" and change the values to your own folders.
# (".env" is listed in .gitignore, so your own folder names never end up in the repository.)

# folder with one sub-folder per video ("7", "8", "9", "10"), each holding annotation/ (LabelMe json) and labels/
GAUGE_FRAMES_DIR=./frames

# YOLO dataset folder: images/train|val and labels/train|val
GAUGE_DATASET_DIR=./dataset

# rectangle_to_four_points.py: folder with LabelMe json files (input) and the folder for the four-point version (output)
GAUGE_QUAD_INPUT_DIR=./annotations_in
GAUGE_QUAD_OUTPUT_DIR=./annotations_four_points

# thresholding / edge experiments: folder with the input frames and the folder for all outputs
GAUGE_CV_INPUT_DIR=./results/classical_cv/input_frames
GAUGE_CV_OUTPUT_DIR=./output

# augment_images.py: folder with the .jpg frames (input) and the folder for the augmented copies (output)
GAUGE_AUG_INPUT_DIR=./data/images/video_09
GAUGE_AUG_OUTPUT_DIR=./augmented_out
